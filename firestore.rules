rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Lista maestra de invitaciones (Compromiso y Boda)
    match /invitaciones/{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /invitaciones_boda/{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Reglas para la fiesta de compromiso
    match /rsvps_compromiso/{document=**} {
      allow read, create, update: if true;
      allow delete: if request.auth != null;
    }

    // Reglas para la boda
    match /rsvps_boda/{document=**} {
      allow read, create, update: if true;
      allow delete: if request.auth != null;
    }
  }
}